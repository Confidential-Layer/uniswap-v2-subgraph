{
  "name": "uniswap-v2-subgraph",
  "license": "MIT",
  "scripts": {
    "create": "graph create --node $GRAPH_NODE_ENDPOINT $GRAPH_NAME",
    "remove": "graph remove --node $GRAPH_NODE_ENDPOINT $GRAPH_NAME",
    "prepare-template": "cross-env ts-node ./scripts/build --network $NETWORK --subgraph-type v2",
    "subgraph-v2-deploy": "cross-env ts-node ./scripts/build --network $NETWORK --subgraph-type v2 --deploy --node $GRAPH_NODE_ENDPOINT --ipfs $IPFS_ENDPOINT --name $GRAPH_NAME --subgraph-version $GRAPH_VERSION",
    "bootstrap": "npm run create && npm run subgraph-v2-deploy"
  },
  "dependencies": {
    "@graphprotocol/graph-cli": "^0.64.1",
    "@graphprotocol/graph-ts": "^0.32.0",
    "cross-env": "7.0.3",
    "dotenv": "16.0.3",   
    "yargs": "17.7.2",
    "ts-node": "10.9.1",
    "mustache": "^3.1.0"
  }
}
